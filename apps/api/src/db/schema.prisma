generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomStatus {
  active
  archived
  deleted
}

enum UserRole {
  user
  moderator
}

enum ReportStatus {
  open
  resolved
  dismissed
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String
  createdAt       DateTime  @default(now())
  role            UserRole  @default(user)
  totpSecret      String?
  totpEnabledAt   DateTime?
  emailVerifiedAt DateTime?
  totalXp         Int       @default(0)
  level           Int       @default(0)
  mutedUntil      DateTime?
  // M7b Slice D2: mutedUntil'in AYNI canlı-durum şekli - reload/reconnect
  // sonrası da görünür kalması için, tek seferlik bir WS toast değil.
  // liftMute mutedUntil ile BİRLİKTE null'a çeker.
  muteReason      String?
  // M6 Slice A: gizlilik politikası/kullanım şartları onayının kanıtlanabilir
  // kaydı - zorunlu ama kaydedilmeyen bir checkbox sonradan hiçbir şey
  // kanıtlamaz. Mevcut kullanıcılar bu onayı hiç vermedi, null kalması
  // DOĞRU (bu onayın hiç sorulmadığı bir kullanıcıyı doğru yansıtıyor).
  termsAcceptedAt DateTime?
  // M5 Slice E: davetçi hesap verebilirliği (B15) - kullanılmamış daveti
  // olmayan bir davetçi için susturma sonucu biriken borç. Bir sonraki
  // grantInvites çağrısı bunu önce karşılar, kalan (varsa) gerçek davet
  // olur. "En çok davet eden" bir kullanıcının elinde revoke edilecek
  // kullanılmamış davet hiç bulunmayabilir - bu alan olmadan mekanik tam
  // da en riskli kullanıcılarda etkisiz kalırdı.
  pendingInviteDebt Int     @default(0)

  // M7a Slice F: hesap-bazlı brute-force kilidi - mutedUntil'in AYNI şekli.
  // failedLoginCount SADECE yanlış ŞİFRE'de artar (TOTP başarısızlığı HİÇ
  // dokunmaz - doğru şifreyi zaten bilen biri için yeni bir taciz aracı
  // olurdu). lockedUntil'in kendisi login()'de İSTEMCİYE HİÇ sızmıyor
  // (ayrı bir hata kodu email-enumeration oracle'ı olurdu) - sadece
  // hesabın kendi kayıtlı e-postasına bir bildirim tetikler.
  // lockoutNotifiedAt o bildirimin en son NE ZAMAN gönderildiğini tutar,
  // döngüler-arası (kilit süresi dolup yeniden tetiklenen) e-posta
  // spam'ini önlemek için (bkz. LOCKOUT_NOTIFICATION_COOLDOWN_MS).
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  lockoutNotifiedAt DateTime?

  inviterId String?
  inviter   User?   @relation("UserInvitedBy", fields: [inviterId], references: [id], onDelete: SetNull)
  invitees  User[]  @relation("UserInvitedBy")

  messages                Message[]
  issuedInvites           Invite[]                 @relation("InviteIssuer")
  usedInvite              Invite?                  @relation("InviteRedeemer")
  refreshTokens           RefreshToken[]
  totpRecoveryCodes       TotpRecoveryCode[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  blocksMade              Block[]                  @relation("Blocker")
  blocksReceived          Block[]                  @relation("Blocked")
  createdRooms            Room[]                   @relation("RoomCreator")
  roomMemberships         RoomMember[]
  reputationEvents        ReputationEvent[]
  reportsFiled            Report[]                 @relation("ReportReporter")
  reportsAgainst          Report[]                 @relation("ReportedUser")
  reportsResolved         Report[]                 @relation("ReportResolver")
  moderationActions       ModerationAuditLog[]     @relation("ModerationActor")
  moderationTargetActions ModerationAuditLog[]     @relation("ModerationTargetUser")
}

model Invite {
  id        String    @id @default(uuid())
  code      String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  // M5 Slice E: davetçi hesap verebilirliği (B15) - usedAt'in yanında
  // ikinci bir terminal durum. Revoke edilmiş bir davet asla redeem
  // edilemez (bkz. InvitesService.findRedeemableInvite).
  revokedAt DateTime?

  issuedById String?
  issuedBy   User?   @relation("InviteIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  usedById String? @unique
  usedBy   User?   @relation("InviteRedeemer", fields: [usedById], references: [id])

  moderationLogs ModerationAuditLog[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  // M7a Slice A: rotasyon-yarışı toleransı (çoklu sekme aynı httpOnly
  // cookie'yi paylaşıyor, iki sekme aynı anda refresh ederse ikincisi
  // normalde artık-revoke-edilmiş bu token'ı görür ve sebepsiz çıkışa
  // düşerdi). revokedAt'ten sonraki kısa bir pencerede (REFRESH_TOKEN_
  // REUSE_GRACE_MS) BİR KEZ daha kullanılmasına izin verilir - bu alan o
  // tek kullanımı işaretler, sınırsız tekrar oynatmayı engeller.
  graceReusedAt DateTime?
  // Grace toleransı SADECE rotasyon-kaynaklı revoke'lara uygulanır - logout
  // ve confirmPasswordReset'in bilerek ANINDA/kesin iptali bu alan false
  // (varsayılan) kaldığı için hiç etkilenmez. Kullanıcı çıkış yaptığında
  // "10 saniye daha çalışır" beklemez.
  revokedByRotation Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TotpRecoveryCode {
  id        String    @id @default(uuid())
  codeHash  String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Block {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  blockerId String
  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String
  blocked   User   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Room {
  id             String     @id @default(uuid())
  name           String     @unique
  description    String?
  status         RoomStatus @default(active)
  createdAt      DateTime   @default(now())
  lastActivityAt DateTime   @default(now())
  archivedAt     DateTime?
  lastViewedAt   DateTime?
  // M7b Slice H2: moderatörün pinleyebileceği tek bir oda-duyurusu -
  // description gibi serbest metin, ayrı bir model gerektirmeyecek kadar
  // basit (tek mutable alan).
  announcement   String?

  creatorId String?
  creator   User?   @relation("RoomCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  messages       Message[]
  moderationLogs ModerationAuditLog[]
  members        RoomMember[]

  // M7b Slice E: keşif/moderasyon listeleri artık lastActivityAt DESC'e
  // göre sıralanıyor (rooms.service.ts) - composite sort'un birincil alanı.
  @@index([lastActivityAt])
}

// M7a Slice B (ADR-0009): yayın/liste scoping için üyelik - erişim kontrolü
// DEĞİL, herhangi bir authed kullanıcı hâlâ herhangi bir aktif odaya isimle
// yazabilir/okuyabilir (messages.service.ts). Sadece kimin gerçek-zamanlı
// yayın aldığını ve "benim odalarım" listesinde neyin göründüğünü belirler.
model RoomMember {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([roomId])
}

model Message {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  // M7b Slice D2: "(düzenlendi)" göstergesi - SADECE editMessage bunu set
  // ediyor. removeMessageContent/deleteOwnMessage BİLEREK set ETMİYOR -
  // ikisi de zaten kendi açıklayıcı placeholder metnini taşıyor, üstüne
  // "(düzenlendi)" eklemek yanıltıcı/gereksiz olurdu.
  editedAt  DateTime?

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  edits            MessageEdit[]
  reputationEvents ReputationEvent[]
  reports          Report[]
  moderationLogs   ModerationAuditLog[]

  @@index([roomId, createdAt])
}

model MessageEdit {
  id              String   @id @default(uuid())
  previousContent String
  editedAt        DateTime @default(now())

  messageId String
  message   Message @relation(fields: [messageId], references: [id])

  @@index([messageId])
}

model ReputationEvent {
  id         String   @id @default(uuid())
  actionType String
  amount     Int
  createdAt  DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  sourceMessageId String?
  sourceMessage   Message? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Report {
  id              String       @id @default(uuid())
  createdAt       DateTime     @default(now())
  status          ReportStatus @default(open)
  resolvedAt      DateTime?
  reason          String?
  // Raporlanan içeriğin o anki bir snapshot'ı - messageId sadece canlı bir
  // referans olsaydı, raporlanan kullanıcı moderatör bakmadan önce mesajını
  // editMessage ile (hâlâ engelsiz) değiştirip kanıtı silebilirdi.
  reportedContent String

  reporterId String?
  reporter   User?   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  // message.authorId'den DENORMALİZE edilerek oluşturulurken yazılır - sadece
  // messageId üzerinden dolaylı kalsaydı hem hesap silme (authorId NULL) hem
  // oda purge (messageId NULL) zincirini koparıp Slice C'nin "aynı kullanıcıya
  // çoklu rapor" sayımını güvenilmez yapardı.
  reportedUserId String?
  reportedUser   User?   @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)

  resolvedById String?
  resolvedBy   User?   @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  auditEntries ModerationAuditLog[]

  @@index([messageId])
  @@index([status])
  @@index([reportedUserId])
}

model ModerationAuditLog {
  id         String   @id @default(uuid())
  // Plain string, ReputationEvent (ADR-0004) ile aynı ilke - yeni aksiyon
  // tipi (Slice B: MUTE_APPLIED/LIFTED, Slice D: ROOM_RENAMED/ARCHIVED/
  // DELETED, Slice E: INVITER_INVITE_REVOKED/DEBT_INCURRED) migration
  // istemesin.
  actionType String
  createdAt  DateTime @default(now())
  // M7b Slice D2: moderatörün aksiyon SEBEBİ - Report.reason'dan (RAPORLAYANIN
  // sebebi) FARKLI bir kavram. Bugün SADECE MUTE_APPLIED/CONTENT_REMOVED
  // dolduruyor, diğer actionType'larda null.
  reason      String?

  moderatorId String?
  moderator   User?   @relation("ModerationActor", fields: [moderatorId], references: [id], onDelete: SetNull)

  targetMessageId String?
  targetMessage   Message? @relation(fields: [targetMessageId], references: [id], onDelete: SetNull)

  // M5 Slice B: mute/unmute'un hedefi - moderatörün "ModerationActor" ilişkisinden
  // AYRI bir isimle, aynı FK-güvenliği gerekçesiyle (AuthService.deleteAccount()
  // User satırlarını hard-delete ediyor).
  targetUserId String?
  targetUser   User?   @relation("ModerationTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  reportId String?
  report   Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  // M5 Slice C: rapor çözüldüğünde (CONTENT_REMOVED/REPORT_DISMISSED) o
  // ANKİ distinct-raporcu sayısının anlık görüntüsü - flag kalıcı
  // saklanmadığı için ("her GET'te yeniden hesaplanır") "bu karar
  // verilirken bir örüntü var mıydı" sorusunu SADECE bu alan
  // cevaplayabilir. Diğer actionType'larda (MUTE_APPLIED,
  // REPORT_QUEUE_VIEWED, ...) null.
  distinctReporterCountAtResolution Int?

  // M5 Slice D: rename/archive/delete'in hedefi - targetRoomId delete
  // sonrası SetNull ile null'a düşer (Postgres FK aksiyonları
  // statement-anında çalışır, commit'te değil - aynı transaction içinde
  // audit satırı ÖNCE yazılsa bile). targetRoomName (rename'de ESKİ isim,
  // delete'de odanın tek kalıcı kaydı) ve targetRoomDescription bu yüzden
  // üçü için de snapshot'lanır - targetRoomId null'a düşse bile denetim
  // izi hangi odanın ne hakkında olduğunu kaybetmesin diye.
  targetRoomId String?
  targetRoom   Room?   @relation(fields: [targetRoomId], references: [id], onDelete: SetNull)

  targetRoomName        String?
  targetRoomDescription String?
  // M7b Slice H2: ROOM_ANNOUNCEMENT_UPDATED'in hedefi - yeni duyuru değeri
  // (temizlendiğinde null) - targetRoomName/targetRoomDescription'ın AYNI
  // snapshot gerekçesi.
  targetRoomAnnouncement String?
  // SADECE ROOM_DELETED'de dolu - kaç mesajın odayla birlikte gittiğini
  // denetim izinde kalıcı kılıyor.
  deletedMessageCount Int?

  // M5 Slice E: INVITER_INVITE_REVOKED'ın hedefi - hangi davetin iptal
  // edildiği. INVITER_INVITE_DEBT_INCURRED'da null (revoke edilecek somut
  // bir davet yok, sadece bir sayaç arttı). Bu iki aksiyon tipinde
  // moderatorId BİLEREK null - otomatik bir sonuç, alanın kod tabanı
  // genelindeki "bu satırı doğrudan tetikleyen moderatör" anlamını koruyor.
  targetInviteId String?
  targetInvite   Invite? @relation(fields: [targetInviteId], references: [id], onDelete: SetNull)

  @@index([moderatorId])
}
