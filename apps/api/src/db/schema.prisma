generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomStatus {
  active
  archived
  deleted
}

enum UserRole {
  user
  moderator
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String
  createdAt       DateTime  @default(now())
  role            UserRole  @default(user)
  totpSecret      String?
  totpEnabledAt   DateTime?
  emailVerifiedAt DateTime?

  inviterId String?
  inviter   User?   @relation("UserInvitedBy", fields: [inviterId], references: [id], onDelete: SetNull)
  invitees  User[]  @relation("UserInvitedBy")

  messages                Message[]
  issuedInvites           Invite[]                 @relation("InviteIssuer")
  usedInvite              Invite?                  @relation("InviteRedeemer")
  refreshTokens           RefreshToken[]
  totpRecoveryCodes       TotpRecoveryCode[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  blocksMade              Block[]                  @relation("Blocker")
  blocksReceived          Block[]                  @relation("Blocked")
}

model Invite {
  id        String    @id @default(uuid())
  code      String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  issuedById String?
  issuedBy   User?   @relation("InviteIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  usedById String? @unique
  usedBy   User?   @relation("InviteRedeemer", fields: [usedById], references: [id])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TotpRecoveryCode {
  id        String    @id @default(uuid())
  codeHash  String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Block {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  blockerId String
  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String
  blocked   User   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Room {
  id        String     @id @default(uuid())
  name      String     @unique
  status    RoomStatus @default(active)
  createdAt DateTime   @default(now())

  messages Message[]
}

model Message {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  edits MessageEdit[]

  @@index([roomId, createdAt])
}

model MessageEdit {
  id              String   @id @default(uuid())
  previousContent String
  editedAt        DateTime @default(now())

  messageId String
  message   Message @relation(fields: [messageId], references: [id])

  @@index([messageId])
}
