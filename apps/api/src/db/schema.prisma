generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomStatus {
  active
  archived
  deleted
}

enum UserRole {
  user
  moderator
}

enum ReportStatus {
  open
  resolved
  dismissed
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String
  createdAt       DateTime  @default(now())
  role            UserRole  @default(user)
  totpSecret      String?
  totpEnabledAt   DateTime?
  emailVerifiedAt DateTime?
  totalXp         Int       @default(0)
  level           Int       @default(0)
  mutedUntil      DateTime?

  inviterId String?
  inviter   User?   @relation("UserInvitedBy", fields: [inviterId], references: [id], onDelete: SetNull)
  invitees  User[]  @relation("UserInvitedBy")

  messages                Message[]
  issuedInvites           Invite[]                 @relation("InviteIssuer")
  usedInvite              Invite?                  @relation("InviteRedeemer")
  refreshTokens           RefreshToken[]
  totpRecoveryCodes       TotpRecoveryCode[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  blocksMade              Block[]                  @relation("Blocker")
  blocksReceived          Block[]                  @relation("Blocked")
  createdRooms            Room[]                   @relation("RoomCreator")
  reputationEvents        ReputationEvent[]
  reportsFiled            Report[]                 @relation("ReportReporter")
  reportsAgainst          Report[]                 @relation("ReportedUser")
  reportsResolved         Report[]                 @relation("ReportResolver")
  moderationActions       ModerationAuditLog[]     @relation("ModerationActor")
  moderationTargetActions ModerationAuditLog[]     @relation("ModerationTargetUser")
}

model Invite {
  id        String    @id @default(uuid())
  code      String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  issuedById String?
  issuedBy   User?   @relation("InviteIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  usedById String? @unique
  usedBy   User?   @relation("InviteRedeemer", fields: [usedById], references: [id])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TotpRecoveryCode {
  id        String    @id @default(uuid())
  codeHash  String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Block {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  blockerId String
  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String
  blocked   User   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Room {
  id             String     @id @default(uuid())
  name           String     @unique
  description    String?
  status         RoomStatus @default(active)
  createdAt      DateTime   @default(now())
  lastActivityAt DateTime   @default(now())
  archivedAt     DateTime?
  lastViewedAt   DateTime?

  creatorId String?
  creator   User?   @relation("RoomCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  messages Message[]
}

model Message {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  edits            MessageEdit[]
  reputationEvents ReputationEvent[]
  reports          Report[]
  moderationLogs   ModerationAuditLog[]

  @@index([roomId, createdAt])
}

model MessageEdit {
  id              String   @id @default(uuid())
  previousContent String
  editedAt        DateTime @default(now())

  messageId String
  message   Message @relation(fields: [messageId], references: [id])

  @@index([messageId])
}

model ReputationEvent {
  id         String   @id @default(uuid())
  actionType String
  amount     Int
  createdAt  DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  sourceMessageId String?
  sourceMessage   Message? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Report {
  id              String       @id @default(uuid())
  createdAt       DateTime     @default(now())
  status          ReportStatus @default(open)
  resolvedAt      DateTime?
  reason          String?
  // Raporlanan içeriğin o anki bir snapshot'ı - messageId sadece canlı bir
  // referans olsaydı, raporlanan kullanıcı moderatör bakmadan önce mesajını
  // editMessage ile (hâlâ engelsiz) değiştirip kanıtı silebilirdi.
  reportedContent String

  reporterId String?
  reporter   User?   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  // message.authorId'den DENORMALİZE edilerek oluşturulurken yazılır - sadece
  // messageId üzerinden dolaylı kalsaydı hem hesap silme (authorId NULL) hem
  // oda purge (messageId NULL) zincirini koparıp Slice C'nin "aynı kullanıcıya
  // çoklu rapor" sayımını güvenilmez yapardı.
  reportedUserId String?
  reportedUser   User?   @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)

  resolvedById String?
  resolvedBy   User?   @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  auditEntries ModerationAuditLog[]

  @@index([messageId])
  @@index([status])
  @@index([reportedUserId])
}

model ModerationAuditLog {
  id         String   @id @default(uuid())
  // Plain string, ReputationEvent (ADR-0004) ile aynı ilke - yeni aksiyon
  // tipi (Slice B: MUTE_APPLIED/LIFTED, Slice D: ROOM_RENAMED/DELETED)
  // migration istemesin.
  actionType String
  createdAt  DateTime @default(now())

  moderatorId String?
  moderator   User?   @relation("ModerationActor", fields: [moderatorId], references: [id], onDelete: SetNull)

  targetMessageId String?
  targetMessage   Message? @relation(fields: [targetMessageId], references: [id], onDelete: SetNull)

  // M5 Slice B: mute/unmute'un hedefi - moderatörün "ModerationActor" ilişkisinden
  // AYRI bir isimle, aynı FK-güvenliği gerekçesiyle (AuthService.deleteAccount()
  // User satırlarını hard-delete ediyor).
  targetUserId String?
  targetUser   User?   @relation("ModerationTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  reportId String?
  report   Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  // M5 Slice C: rapor çözüldüğünde (CONTENT_REMOVED/REPORT_DISMISSED) o
  // ANKİ distinct-raporcu sayısının anlık görüntüsü - flag kalıcı
  // saklanmadığı için ("her GET'te yeniden hesaplanır") "bu karar
  // verilirken bir örüntü var mıydı" sorusunu SADECE bu alan
  // cevaplayabilir. Diğer actionType'larda (MUTE_APPLIED,
  // REPORT_QUEUE_VIEWED, ...) null.
  distinctReporterCountAtResolution Int?

  @@index([moderatorId])
}
